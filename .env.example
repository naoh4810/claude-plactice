# === 必須 ===
# Anthropic APIキー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# === 任意：Notion の「デイリー学習ログ」を記事の素材にする場合 ===
# Notion インテグレーションのトークン（https://www.notion.so/my-integrations で発行し、
# 対象データベースに「コネクトを追加」で接続しておく）
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxx

# デイリー学習ログのデータベースID（NotionのURLの32桁）
# 例: https://notion.so/xxxx?v=... の xxxx 部分
NOTION_DAILY_LOG_DATABASE_ID=33bdbb425bd68007b81aee216a3bc745

# === 任意：モデル・生成設定（未設定ならデフォルト値を使用）===
# 使用モデル（デフォルト: claude-opus-5）
ARTICLE_MODEL=claude-opus-5
# 最新情報をWeb検索で補強するか（true/false, デフォルト: false）
ENABLE_WEB_SEARCH=false

# === 案件チェック自動化（scripts/job_*.py）===
# 判定・応募文生成のモデル（デフォルト: claude-opus-5-5）
JOB_MODEL=
# Slack Incoming Webhook の URL（https://api.slack.com/messaging/webhooks）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# 〇△があるときにメンションする自分の Slack メンバーID（プロフィール →「︙」→ メンバーIDをコピー）
SLACK_MENTION_USER=U0123ABCD
# 任意：Chrome の場所が標準と違う場合のみ（例: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome）
JOB_CHROME_PATH=
# 任意：Google スプレッドシートにも台帳を書く場合
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
JOB_SHEET_ID=
JOB_SHEET_TAB=案件台帳
