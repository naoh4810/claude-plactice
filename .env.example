# === 必須 ===
# Anthropic APIキー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# === 任意：Notion の「デイリー学習ログ」を記事の素材にする場合 ===
# Notion インテグレーションのトークン（https://www.notion.so/my-integrations で発行し、
# 対象データベースに「コネクトを追加」で接続しておく）
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxx

# デイリー学習ログのデータベースID（NotionのURLの32桁）
# 例: https://notion.so/xxxx?v=... の xxxx 部分
NOTION_DAILY_LOG_DATABASE_ID=33bdbb425bd68007b81aee216a3bc745

# === 任意：モデル・生成設定（未設定ならデフォルト値を使用）===
# 使用モデル（デフォルト: claude-opus-5）
ARTICLE_MODEL=claude-opus-5
# 最新情報をWeb検索で補強するか（true/false, デフォルト: false）
ENABLE_WEB_SEARCH=false

# === 任意：Computer Use 営業デモ（demo/computer_use）===
# 報告を投稿する Slack の Incoming Webhook URL（未設定なら送信せずパネルに表示だけ）
SLACK_WEBHOOK_URL=
# デモで使うモデル・考える深さ（未設定なら claude-opus-5-5 / medium）
DEMO_MODEL=
DEMO_EFFORT=
